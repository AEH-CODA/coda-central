# Copy to .env (gitignored). Values shown are the compose defaults.
DATABASE_URL=postgresql://coda:coda-pass@inference-db:5432/inference-db
DATA_DIR=/data
MODELS_DIR=/models
# comma-separated <id>@<version>; each must exist as models/<id>/<version>/model.yaml
ENABLED_MODELS=oct-fluid-spectralis@1.0.0

# must match auth-service (tokens are validated here too, as in dataset-service)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

MAX_UPLOAD_MB=300
RESULT_TTL_DAYS=30
KEEP_INPUT=false

# worker tuning (optional)
# WORKER_POLL_SECONDS=2
# HEARTBEAT_SECONDS=15
# STALE_JOB_MINUTES=10
# MAX_ATTEMPTS=2
# VERIFY_MODEL_CHECKSUM=true

FRONTEND_ORIGINS=http://localhost:5000
