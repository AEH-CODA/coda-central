        "predicate": "ncit:Concept_In_Subset",
        "class": "ncit:C25364",
        "fieldType": "Alphanumeric Identifier",
        "sqlType": "varchar(255)",
        "description": "Anonymized medical record number of the patient. This number is specific to the patient's medical record number in the specific hospital and is used for tracking visits. It is visible to the users of the system and is used by clinicians to track visits, diagnosis, history etc of the patient.",
        "schemaReconstruction": [
          {
            "@type": "schema:ClassNode",
            "classLabel": "Patient",
            "predicate": "coda:hasConceptClass",
            "aestheticLabel": "Patient_Information"
          }
        ]
      },
