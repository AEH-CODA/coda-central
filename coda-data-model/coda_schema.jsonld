    "variables": {
      "anonymous_uid": {
        "@id": "schema:variable/anonymous_uid",
        "@type": "schema:IdentifierVariable",
        "dataType": "identifier",
        "predicate": "ncit:Concept_In_Subset",
        "class": "ncit:C25364",
        "fieldType": "Alphanumeric Identifier",
        "sqlType": "varchar(255)",
        "description": "A unique identifier for the patient, anonymized to protect privacy. This UID represents the patient's identification and is common across hospitals in the network. It is system generated and not visible to the patient or clinicians.",
        "schemaReconstruction": [
          {
            "@type": "schema:ClassNode",
            "classLabel": "Patient",
            "predicate": "coda:hasConceptClass",
            "aestheticLabel": "Patient_Information"
          }
        ]
      },
      "anonymous_mrno": {
        "@id": "schema:variable/anonymous_mrno",
